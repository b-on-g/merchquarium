$bog_nka_app $mol_page
	Settings_title @ \Settings
	Return_title @ \Return
	Filter_all @ \All
	title @ \Catalog 
	Product_card* $bog_nka_product_card
		product_link <= product_link* \
		catalog_link <= catalog_link \
	plugins /
		<= Theme_auto $mol_theme_auto
		<= Ico $bog_favicon
			Icon <= ico $mol_icon_all_inclusive
	head /
		<= Product_add $mol_button_major
			title @ \Add product
			click? <=> product_add? null
			hidden <= is_admin false
		<= Category_filter $mol_switch
			options <= category_filter_options *
			value? <=> category_filter? \all
		^ 
	tools /
		<= Lights $mol_lights_toggle
		<= Settings_button $mol_button_minor
			title <= settings_button_title \
			click? <=> settings_toggle? null
			hidden <= is_admin false
	body <= content /
		<= Catalog_missing $mol_view
			sub /
				<= Catalog_missing_text $mol_paragraph
					title @ \No catalog selected:
				<= Catalog_create $mol_button_major
					title @ \Create catalog
					click? <=> catalog_create? null
		<= Catalog_selected $mol_view
			sub /
				<= Product_cards $mol_gallery
					items <= product_cards /
		<= Settings $bog_nka_settings
			catalog_link <= catalog_link \
