$bog_nka_app $mol_page
	Settings_title @ \Settings
	Return_title @ \Return
	Filter_all @ \All
	title @ \Catalog 
	Product_card* $bog_nka_product_card
		product_link <= product_link* \
		catalog_link <= catalog_link \
		product_delete? <=> product_delete*? null
	Product_undo* $mol_button_major
		title @ \Undo
		click? <=> product_undo*? null
	plugins /
		<= Theme_auto $mol_theme_auto
		<= Ico $bog_favicon
			Icon <= ico $mol_icon_all_inclusive
		<= Undo_hotkey $mol_hotkey2
			action *
				ctrl_Z? <=> undo_last? null
	head /
		<= Title
		<= Product_add $bog_nka_button
			title @ \Add product
			click? <=> product_add? null
			hidden <= is_not_admin true
		<= Tools
	tools /
		<= Lights $mol_lights_toggle
		<= Settings_button $mol_button_minor
			hint <= settings_button_title \
			click? <=> settings_toggle? null
			sub <= settings_button_sub /
				<= Settings_icon $mol_icon_cog
				<= Return_icon $mol_icon_arrow_left
	body <= content /
		<= Catalog_missing $mol_view
			sub /
				<= Catalog_missing_text $mol_paragraph
					title @ \No catalog selected:
				<= Catalog_create $bog_nka_button
					title @ \Create catalog
					click? <=> catalog_create? null
		<= Catalog_selected $mol_list
			rows <= catalog_rows /
				<= Category_filter $mol_switch
					options <= category_filter_options *
					value? <=> category_filter? \all
				<= Product_cards $bog_nka_gallery
					items <= product_cards /
				<= Catalog_empty $mol_paragraph
					title @ \Products coming soon
		<= Settings $bog_nka_settings
			catalog_link <= catalog_link \
