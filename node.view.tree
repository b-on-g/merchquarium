$mol_string_button $mol_string

$mol_icon_menu $mol_icon path \M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z

$mol_icon_menu_down $mol_icon path \M7,10L12,15L17,10H7Z

$mol_icon_menu_down_outline $mol_icon path \M18,9V10.5L12,16.5L6,10.5V9H18M12,13.67L14.67,11H9.33L12,13.67Z

$mol_icon_menu_up $mol_icon path \M7,15L12,10L17,15H7Z

$mol_icon_menu_up_outline $mol_icon path \M18,16V14.5L12,8.5L6,14.5V16H18M12,11.33L14.67,14H9.33L12,11.33Z

$mol_number $mol_view
	precision_view <= precision 0
	precision_change <= precision 0
	boost 10
	value_min -Infinity
	value_max +Infinity
	value? +NaN
	enabled true
	plugins /
		<= Hotkey $mol_hotkey
			key *
				down? <=> event_dec? null
				up? <=> event_inc? null
				pageDown? <=> event_dec_boost? null
				pageUp? <=> event_inc_boost? null
	sub /
		<= String $mol_string
			- \ we don't want native number controls in mobile devices
			- \ https://stackoverflow.com/questions/3790935/can-i-hide-the-html5-number-input-s-spin-box
			type <= type \text
			keyboard \decimal
			value? <=> value_string? \
			hint <= hint \ 
			enabled <= string_enabled <= enabled
			submit? <=> submit? null
			selection? <=> selection? /number
		<= Dec $mol_button_minor
			event_click? <=> event_dec? null
			enabled <= dec_enabled <= enabled
			sub / <= dec_icon $mol_icon_menu_down_outline
		<= Inc $mol_button_minor
			event_click? <=> event_inc? null
			enabled <= inc_enabled <= enabled
			sub / <= inc_icon $mol_icon_menu_up_outline

$bog_merchquarium_number $mol_number

$mol_select_list $mol_view
	value? /string
	dictionary *
	badges_list <= Badges /$mol_view
	Badge* $mol_button_minor
		title <= badge_title* \badge
		click? <=> remove*? null
		hint <= badge_hint @ \Drop
		enabled <= drop_enabled <= enabled true
	sub /$mol_view
		<= Pick $mol_select
			event_select*? <=> event_select*? null
			align_hor <= align_hor \right
			options <= options_pickable <= options /string
			value? <=> pick? \
			option_label* <= option_title* \
			trigger_enabled <= pick_enabled <= enabled true
			hint <= pick_hint @ \Add..
			filter_pattern? => filter_pattern?
			Trigger_icon <= Pick_icon $mol_icon_plus
		^ badges_list

$mol_check_list $mol_view
	dictionary *
	Option* $mol_check
		checked? <=> option_checked*? false
		label <= option_label* /
			<= option_title* \
		enabled <= option_enabled* <= enabled true
		hint <= option_hint* \
		minimal_height 24
	options *
	keys /string
	sub <= items /$mol_check

$mol_switch $mol_check_list
	value? \

$bog_merchquarium_product_card $mol_card
	product_link? \
	catalog_link? \
	search? \
	cart_count? 0
	editable true
	Want_message @ \I want {title} if there is a reprint: {link}
	Want_title @ \I want it if there is a reprint
	Want_copied_title @ \✓ Copied — open {social}
	Tag* $mol_button_minor
		title <= tag_title* \
		click? <=> tag_select*? null
	attr *
		^
		bog_merchquarium_product_card_state <= status? \available
	sub /
		<= Cover $mol_view
			sub <= cover /
				<= Photos $bog_merchquarium_carousel
					ids <= photo_ids /string
					url* <= photo_url* \
				<= Photo_empty $mol_view
					sub /
						<= Photo_empty_icon $mol_icon_image_off
				<= Sold_badge $mol_paragraph
					title @ \Sold out
		<= Info $mol_list
			rows <= info_rows /
				<= Title $mol_string_button
					value? <=> title? \
					hint @ \Title
					enabled <= changed true
				<= Price $bog_merchquarium_number
					value_min 0
					hint @ \Price
					value? <=> price? null
					enabled <= changed true
				<= Price_text $mol_paragraph
					title <= price_text \
				<= Description $mol_string_button
					value? <=> description? \
					hint @ \Description
					enabled <= changed true
				<= Description_text $mol_paragraph
					title <= description \
				<= Category $mol_select
					options <= category_list /
					option_label_default @ \Category
					enabled <= changed true
					value? <=> category? null
				<= Fandoms $mol_select_list
					value? <=> fandoms? /string
					dictionary <= fandom_dictionary *
					pick_hint @ \Fandoms
					enabled <= changed true
				<= Tags $mol_view
					sub <= tags /
		<= Cart_controls $mol_view
			sub <= cart_controls /
				<= Cart_add $mol_button_major
					title @ \Add to cart
					click? <=> cart_add? null
					enabled <= cart_enabled true
				<= Cart_counter $bog_merchquarium_counter
					value? <=> cart_count?
				<= Want $mol_button_minor
					title <= want_title \
					click? <=> want? null
					enabled <= want_enabled true
		- далее скрытые от клиента поля
		<= Admin $mol_row
			sub /
				<= Photos_add $mol_button_open
					files? <=> photos_add? /File
					enabled <= changed true
					accept \image/*
				<= Photos_delete $mol_button_minor
					title @ \Delete photo
					click? <=> photo_delete? null
					enabled <= photo_delete_enabled true
				<= Status $mol_switch
					value? <=> status? \available
					options *
						available @ \In stock
						sold @ \Sold out
						hidden @ \Hidden
					enabled <= changed true
				<= Delete $mol_button_minor
					title @ \Delete
					click? <=> product_delete? null

