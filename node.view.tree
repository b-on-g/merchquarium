					Filter null
					dictionary <= tier_options *
						deny @ \🛑 Deny
						read @ \👀 Read
						post @ \✍ Post
						pull @ \🥂 Pull
						rule @ \👑 Rule
					enabled <= enabled false
				<= Gift_name* $giper_baza_link_chip
					param <= link_param \link
					link <= peer_link* $giper_baza_link
					sub /
						^
						<= Gift_avatar* $mol_avatar
							id <= peer_id* \

$bog_nka_settings $mol_page
	title @ \Settings
	Import_summary @ \Will add products: {products}, new categories: {categories}
	Import_errors @ \Problems: {errors}
	Theme_sakura @ \Sakura
	Theme_lavender @ \Lavender
	Theme_mint @ \Mint
	Theme_peach @ \Peach
	Theme_sky @ \Sky
	Theme_milk @ \Milk
	Theme_classic @ \Classic
	catalog_link? \
	tools /
		<= Sync $giper_baza_status
	body /
		<= Account_section $mol_section
			title @ \Account
			content /
				<= Account_label $mol_paragraph
					title @ \Your account id:
				<= Account_lord $mol_paragraph
					title <= account_lord \
				<= Account_id $mol_button_copy
					title <= account_id \
		<= Look_section $mol_section
			title @ \Appearance
			content /
				<= Catalog_title $mol_string
					hint @ \Catalog title
					value? <=> catalog_title? \
				<= Themes $mol_view
					sub <= theme_options /
				<= Listed $mol_check_box
					title @ \Show in search engines
					checked? <=> listed? true
		<= Sales_section $mol_section
			title @ \Sales
			content /
				<= Social_link $mol_string
					hint @ \social link
					value? <=> social_link? \
				<= Social_text $mol_string
					hint @ \Example (used by default message ): "Hello! I want to buy {title}!" 
					value? <=> social_text? \
		<= Categories_section $mol_section
			title @ \Categories
			content <= categories_content /
				<= Category_form $mol_row
					sub /
						<= Category_input $mol_string
							hint @ \New category
							value? <=> category_draft? \
						<= Category_add $mol_button_major
							title @ \Add category
							click? <=> category_add? null
				<= Categories_list $mol_view
					sub <= category_rows /
		<= Import_section $mol_section
			title @ \Bulk import
			content /
				<= Import_hint $mol_paragraph
					title @ \Copy the prompt, talk to any AI chat and paste its JSON below. Upload photos to the cards afterwards.
				<= Import_prompt $mol_button_copy
					title @ \Copy prompt for AI
					text <= import_prompt \
				<= Import_json $mol_textarea
					hint @ \Paste JSON here
					value? <=> import_json? \
				<= Import_preview $mol_paragraph
					title <= import_preview \
				<= Import_run $mol_button_major
					title @ \Create products
					click? <=> import_run? null
					enabled <= import_ready false
		<= Access_section $mol_section
			title @ \Access
			content /
				<= Debug_info $mol_paragraph
					title <= debug_info \
				<= Rights $giper_baza_land_rights
					land <= catalog_land null
	Category_row* $mol_row
		sub /
			<= Category_title* $mol_paragraph
				title <= category_title* \
			<= Category_remove* $mol_pop
				Anchor <= Category_remove_button* $mol_button_minor
					hint @ \Remove
					sub /
						<= Category_remove_icon* $mol_icon_close
					click? <=> category_remove*? null
				bubble_content /
					<= Category_confirm_title* $mol_paragraph
						title @ \Delete this category?
					<= Category_confirm_info* $mol_paragraph
						title @ \Deleting it will also clear the category from these products:
					<= Category_confirm_count* $mol_paragraph
						title <= category_product_count* \
					<= Category_confirm_actions* $mol_row
						sub /
							<= Category_cancel* $mol_button_minor
								title @ \Cancel
								click? <=> category_remove_cancel*? null
							<= Category_confirm* $mol_button_major
								title @ \Delete category
								click? <=> category_remove_confirm*? null
	Theme_option* $mol_button_minor
		click? <=> theme_select*? null
		sub /
			<= Theme_swatch* $mol_view
				style <= theme_swatch* *
			<= Theme_name* $mol_view
				sub /
					<= theme_name* \

$mol_card $mol_list
	attr *
		^
		mol_card_status_type <= status \
	rows /$mol_view
		<= Content $mol_view
			sub <= content /$mol_view_content
				<= title
		<= Status $mol_view
			minimal_height 30
			sub /
				<= status_text <= status \

$mol_icon_camera $mol_icon path \M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z

$mol_icon_camera_off $mol_icon path \M1.2,4.47L2.5,3.2L20,20.72L18.73,22L16.73,20H4A2,2 0 0,1 2,18V6C2,5.78 2.04,5.57 2.1,5.37L1.2,4.47M7,4L9,2H15L17,4H20A2,2 0 0,1 22,6V18C22,18.6 21.74,19.13 21.32,19.5L16.33,14.5C16.76,13.77 17,12.91 17,12A5,5 0 0,0 12,7C11.09,7 10.23,7.24 9.5,7.67L5.82,4H7M7,12A5,5 0 0,0 12,17C12.5,17 13.03,16.92 13.5,16.77L11.72,15C10.29,14.85 9.15,13.71 9,12.28L7.23,10.5C7.08,10.97 7,11.5 7,12M12,9A3,3 0 0,1 15,12C15,12.35 14.94,12.69 14.83,13L11,9.17C11.31,9.06 11.65,9 12,9Z

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$yuf_carousel $mol_view
	index? 0
	scroll_x? 0
	auto_scroll true
	minimal_height 120
	ids /string - ids or urls
	empty* /$mol_view <= Empty* $mol_icon_camera_off
	sub <= images /$mol_view <= Image*0 $yuf_carousel_image
		uri <= url* \
		error? <=> url_error*? null
	event *
		^
		mousemove? <=> event_move? null
		scroll? <=> event_scroll? null

$yuf_carousel_image $mol_image
	minimal_height 120
	event *
		^
		error? <=> error? null

$bog_nka_carousel $yuf_carousel

$mol_icon_image $mol_icon path \M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z

$mol_icon_image_off $mol_icon path \M21 17.2L6.8 3H19C20.1 3 21 3.9 21 5V17.2M20.7 22L19.7 21H5C3.9 21 3 20.1 3 19V4.3L2 3.3L3.3 2L22 20.7L20.7 22M16.8 18L12.9 14.1L11 16.5L8.5 13.5L5 18H16.8Z

$mol_string_button $mol_string

$mol_icon_menu $mol_icon path \M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z

$mol_icon_menu_down $mol_icon path \M7,10L12,15L17,10H7Z

$mol_icon_menu_down_outline $mol_icon path \M18,9V10.5L12,16.5L6,10.5V9H18M12,13.67L14.67,11H9.33L12,13.67Z

$mol_icon_menu_up $mol_icon path \M7,15L12,10L17,15H7Z

$mol_icon_menu_up_outline $mol_icon path \M18,16V14.5L12,8.5L6,14.5V16H18M12,11.33L14.67,14H9.33L12,11.33Z

$mol_number $mol_view
	precision_view <= precision 0
	precision_change <= precision 0
	boost 10
	value_min -Infinity
	value_max +Infinity
	value? +NaN
	enabled true
	plugins /
		<= Hotkey $mol_hotkey
			key *
				down? <=> event_dec? null
				up? <=> event_inc? null
				pageDown? <=> event_dec_boost? null
				pageUp? <=> event_inc_boost? null
	sub /
		<= String $mol_string
			- \ we don't want native number controls in mobile devices
			- \ https://stackoverflow.com/questions/3790935/can-i-hide-the-html5-number-input-s-spin-box
			type <= type \text
			keyboard \decimal
			value? <=> value_string? \
			hint <= hint \ 
			enabled <= string_enabled <= enabled
			submit? <=> submit? null
			selection? <=> selection? /number
		<= Dec $mol_button_minor
			event_click? <=> event_dec? null
			enabled <= dec_enabled <= enabled
			sub / <= dec_icon $mol_icon_menu_down_outline
		<= Inc $mol_button_minor
			event_click? <=> event_inc? null
			enabled <= inc_enabled <= enabled
			sub / <= inc_icon $mol_icon_menu_up_outline

$bog_nka_number $mol_number

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_nka_product_card $mol_card
	product_link? \
	catalog_link? \
	Buy_title @ \Buy now!
	Social_missing_title @ \Social link is not set
	sub /
		<= Cover $mol_view
			sub <= cover /
				<= Photos $bog_nka_carousel
					ids <= photo_ids /string
					url* <= photo_url* \
				<= Photo_empty $mol_view
					sub /
						<= Photo_empty_icon $mol_icon_image_off
		<= Info $mol_list
			rows <= info_rows /
				<= Title $mol_string_button
					value? <=> title? \
					hint @ \Title
					enabled <= changed true
				<= Price $bog_nka_number
					value_min 0
					hint @ \Price
					value? <=> price? null
					enabled <= changed true
				<= Price_text $mol_paragraph
					title <= price_text \
				<= Description $mol_string_button
					value? <=> description? \
					hint @ \Description
					enabled <= changed true
				<= Description_text $mol_paragraph
					title <= description \
				<= Category $mol_select
					options <= category_list /
					option_label_default @ \Category
					enabled <= changed true
					value? <=> category? null
				<= Category_text $mol_paragraph
					title <= category_text \
		<= Buy $mol_button_major
			title <= buy_title \
			click? <=> buy? null
			enabled <= buy_enabled true
		- далее скрытые от клиента поля
		<= Admin $mol_row
			sub /
				<= Photos_add $mol_button_open
					files? <=> photos_add? /File
					enabled <= changed true
					accept \image/*
				<= Photos_delete $mol_button_minor
					title @ \Delete photo
					click? <=> photo_delete? null
					enabled <= photo_delete_enabled true
				<= Available $mol_check_box
					checked? <=> available? false
					title @ \Available
					enabled <= changed true
				<= Delete $mol_button_minor
					title @ \Delete
					click? <=> product_delete? null

$bog_nka_app $mol_page
	Settings_title @ \Settings
	Return_title @ \Return
	Filter_all @ \All
	title @ \Catalog 
	seo_server \https://cmyser-ru-nka.91.188.212.151.ip.giper.dev/
	Product_card* $bog_nka_product_card
		product_link <= product_link* \
		catalog_link <= catalog_link \
		product_delete? <=> product_delete*? null
	Product_undo* $mol_button_major
		title @ \Undo
		click? <=> product_undo*? null
	plugins /
		<= Theme_auto $mol_theme_auto
		<= Ico $bog_favicon
			Icon <= ico $mol_icon_all_inclusive
		<= Undo_hotkey $mol_hotkey2
			action *
				ctrl_Z? <=> undo_last? null
	head /
		<= Title
		<= Product_add $bog_nka_button
			title @ \Add product
			click? <=> product_add? null
			hidden <= is_not_admin true
		<= Tools
	tools /
		<= Lights $mol_lights_toggle
		<= Settings_button $mol_button_minor
			hint <= settings_button_title \
			click? <=> settings_toggle? null
			sub <= settings_button_sub /
				<= Settings_icon $mol_icon_cog
				<= Return_icon $mol_icon_arrow_left
	body <= content /
		<= Catalog_missing $mol_view
			sub /
				<= Catalog_missing_text $mol_paragraph
					title @ \No catalog selected:
				<= Catalog_create $bog_nka_button
					title @ \Create catalog
					click? <=> catalog_create? null
		<= Catalog_selected $mol_list
			rows <= catalog_rows /
				<= Category_filter $mol_switch
					options <= category_filter_options *
					value? <=> category_filter? \all
				<= Product_cards $bog_nka_gallery
					items <= product_cards /
				<= Catalog_empty $mol_paragraph
					title @ \Products coming soon
		<= Settings $bog_nka_settings
			catalog_link <= catalog_link \
