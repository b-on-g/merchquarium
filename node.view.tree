$giper_baza_status $mol_select
	minimal_width 40
	minimal_height 40
	Filter null
	option_content* /
		<= Option_logo* $mol_avatar
			id <= master_id* \
		<= option_label*
	trigger_content /
		<= Link $mol_link
			uri <= master_link \
			sub <= link_content /
				<= Well $mol_avatar
					id <= master_link \
				<= Fail $mol_icon_sync_off
			hint <= message <= hint \Sync status

$mol_section $mol_list
	level 1
	rows /
		<= Head $mol_view
			sub <= head /
				<= Title $mol_view
					dom_name <= title_dom_name \h1
					sub / <= title
				<= Tools $mol_view sub <= tools /
		<= Content $mol_list
			rows <= content /

$mol_row $mol_view

$bog_merchquarium_tags $mol_view
	items /string
	editable false
	input_hint \
	marker \
	add_title @ \Add
	confirm_title @ \Delete this tag?
	confirm_info @ \Deleting it will also clear it from these products:
	confirm_action @ \Delete
	usage* 0
	item_add*? null
	item_drop*? null
	sub <= content /
		<= Form $mol_row
			sub /
				<= Input $mol_string
					hint <= input_hint
					value? <=> draft? \
					submit? <=> submit? null
				<= Add $mol_button_major
					title <= add_title
					click? <=> submit? null
		<= List $mol_view
			sub <= rows /
	Row* $mol_row
		sub /
			<= Name* $mol_paragraph
				title <= name* \
			<= Remove* $mol_pop
				showed? <=> confirming*? false
				Anchor <= Remove_button* $mol_button_minor
					hint @ \Remove
					sub /
						<= Remove_icon* $mol_icon_close
					click? <=> remove*? null
				bubble_content /
					<= Confirm_title* $mol_paragraph
						title <= confirm_title
					<= Confirm_info* $mol_paragraph
						title <= confirm_info
					<= Confirm_count* $mol_paragraph
						title <= usage_text* \
					<= Confirm_actions* $mol_row
						sub /
							<= Cancel* $mol_button_minor
								title @ \Cancel
								click? <=> cancel*? null
							<= Confirm* $mol_button_major
								title <= confirm_action
								click? <=> confirm*? null

$mol_textarea $mol_stack
	attr *
		^
		mol_textarea_clickable <= clickable? false
		mol_textarea_sidebar_showed <= sidebar_showed false
	event *
		keydown? <=> press? null
		pointermove? <=> hover? null
	sub /
		<= Edit $mol_textarea_edit
			value? <=> value? \
			hint <= hint \ 
			enabled <= enabled true
			spellcheck <= spellcheck true
			length_max <= length_max +Infinity
			selection? <=> selection? /number
			bring => bring
			submit? <=> submit? null
			submit_with_ctrl <= submit_with_ctrl true
		<= View $mol_text_code
			text <= value
			render_visible_only false
			row_numb* <= row_numb* 0
			sidebar_showed <= sidebar_showed
			highlight <= highlight \
			syntax <= syntax $mol_syntax2
	symbols_alt *string
		comma \<
		period \>
		dash \−
		equals \≈
		graveAccent \́
		forwardSlash \÷
		E \€
		V \✔
		X \×
		C \©
		P \§
		H \₽
		key0 \°
		key8 \•
		key2 \@
		key3 \#
		key4 \$
		key6 \^
		key7 \&
		bracketOpen \[
		bracketClose \]
		slashBack \|
	symbols_alt_ctrl *string
		space \ 
	symbols_alt_shift *string
		V \✅
		X \❌
		O \⭕
		key1 \❗
		key4 \💲
		key7 \❓
		comma \«
		period \»
		semicolon \“
		quoteSingle \”
		dash \—
		equals \≠
		graveAccent \̱
		bracketOpen \{
		bracketClose \}

$mol_textarea_edit $mol_string
	dom_name \textarea
	enter \enter
	field *
		^
		scrollTop 0

$mol_icon_plus $mol_icon path \M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z

$giper_baza_link_chip $mol_link
	param \link
	link $giper_baza_link
	sub /
		<= icon \
		<= title

$giper_baza_land_rights $mol_list
	land $giper_baza_land
	rows /
		<= Add $mol_view sub /
			<= Add_key $mol_string
				hint @ \Public key
				value? <=> add_key? \
				submit? <=> add_commit? null
				enabled <= enabled false
			<= Add_commit $mol_button_minor
				click? <=> add_commit? null
				enabled <= enabled false
				sub /
					<= Add_commit_icon $mol_icon_plus
		^ gifts /
			<= Gift*0 $mol_view sub /
				<= Gift_rate* $mol_select
					hint @ \Speed
					value? <=> gift_rate*? \0
					enabled <= enabled false
					Filter null
					dictionary *
						0 \0 🦼 ~1W
						1 \1 🚲 ~3D
						2 \2 🛵 ~1D
						3 \3 🚜 ~D/2
						4 \4 🏇 ~8h
						5 \5 🚂 ~4h
						6 \6 🚛 ~2h
						7 \7 🚗 ~1h
						8 \8 🏍️ ~h/2
						9 \9 🏎️ ~5m
						A \A 🚅 ~2m
						B \B 🚁 ~m/2
						C \C 🛩️ ~2s
						D \D ✈️ ~s/2
						E \E 🚀 ~50ms
						F \F 🛸 ~1ms
				<= Gift_tier* $mol_select
					hint @ \Level
					value? <=> gift_tier*? \deny
					Filter null
					dictionary <= tier_options *
						deny @ \🛑 Deny
						read @ \👀 Read
						post @ \✍ Post
						pull @ \🥂 Pull
						rule @ \👑 Rule
					enabled <= enabled false
				<= Gift_name* $giper_baza_link_chip
					param <= link_param \link
					link <= peer_link* $giper_baza_link
					sub /
						^
						<= Gift_avatar* $mol_avatar
							id <= peer_id* \

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_merchquarium_settings $mol_page
	title @ \Settings
	Import_summary @ \Will add products: {products}, new categories: {categories}, new fandoms: {fandoms}, new links: {links}
	Import_errors @ \Problems: {errors}
	Theme_sakura @ \Sakura
	Theme_lavender @ \Lavender
	Theme_mint @ \Mint
	Theme_peach @ \Peach
	Theme_sky @ \Sky
	Theme_milk @ \Milk
	Theme_classic @ \Classic
	catalog_link? \
	head /
		<= Title
		<= Lang $mol_locale_select
			dictionary *
				ru \Русский
				en \English
		<= Tools
	tools /
		<= Sync $giper_baza_status
	body /
		<= Account_section $mol_section
			title @ \Account
			content /
				<= Account_label $mol_paragraph
					title @ \Your account id:
				<= Account_lord $mol_paragraph
					title <= account_lord \
				<= Account_id $mol_button_copy
					title <= account_id \
		<= Look_section $mol_section
			title @ \Appearance
			content /
				<= Catalog_title $mol_string
					hint @ \Catalog title
					value? <=> catalog_title? \
				<= Images $mol_view
					sub /
						<= Image_field*Avatar
						<= Image_field*Cover
						<= Image_field*Back
				<= Themes $mol_view
					sub <= theme_options /
				<= Listed $mol_check_box
					title @ \Show in search engines
					checked? <=> listed? true
		<= Sales_section $mol_section
			title @ \Sales
			content /
				<= Social_link $mol_string
					hint @ \Link for orders: @nick or t.me/nick
					value? <=> social_link? \
				<= Social_text $mol_string
					hint @ \Request message: {count} items, {total} sum, {title} names, {link} order link
					value? <=> social_text? \
				<= Links_label $mol_paragraph
					title @ \Other socials in the header
				<= Links $bog_merchquarium_tags
					items <= link_items /string
					editable <= is_admin false
					input_hint @ \vk.com/nick, youtube.com/@nick
					item_add*? <=> link_add*? null
					item_drop*? <=> link_drop*? null
		<= Categories_section $mol_section
			title @ \Merch kinds
			content /
				<= Categories $bog_merchquarium_tags
					items <= category_items /string
					editable <= is_admin
					input_hint @ \New merch kind
					confirm_title @ \Delete this merch kind?
					usage* <= category_usage* 0
					item_add*? <=> category_add*? null
					item_drop*? <=> category_drop*? null
		<= Fandoms_section $mol_section
			title @ \Fandoms
			content /
				<= Fandoms $bog_merchquarium_tags
					items <= fandom_items /string
					editable <= is_admin
					input_hint @ \New fandom
					marker \#
					confirm_title @ \Delete this fandom?
					usage* <= fandom_usage* 0
					item_add*? <=> fandom_add*? null
					item_drop*? <=> fandom_drop*? null
		<= Import_section $mol_section
			title @ \Bulk import
			content /
				<= Import_hint $mol_paragraph
					title @ \Copy the prompt, talk to any AI chat and paste its JSON below. Upload photos to the cards afterwards.
				<= Import_prompt $mol_button_copy
					title @ \Copy prompt for AI
					text <= import_prompt \
				<= Import_json $mol_textarea
					hint @ \Paste JSON here
					value? <=> import_json? \
				<= Import_preview $mol_paragraph
					title <= import_preview \
				<= Import_run $mol_button_major
					title @ \Create products
					click? <=> import_run? null
					enabled <= import_ready false
		<= Access_section $mol_section
			title @ \Access
			content /
				<= Debug_info $mol_paragraph
					title <= debug_info \
				<= Rights $giper_baza_land_rights
					land <= catalog_land null
	Image_field* $mol_view
		sub /
			<= Image_preview* $mol_view
				style <= image_style* *
			<= Image_actions* $mol_view
				sub /
					<= Image_pick* $mol_button_open
						files? <=> image_add*? /File
						multiple false
						accept \image/*
						sub /
							^
							<= image_title* \
					<= Image_drop* $mol_button_minor
						hint @ \Remove image
						enabled <= image_filled* false
						click? <=> image_drop*? null
						sub /
							<= Image_drop_icon* $mol_icon_close
	Image_avatar @ \Avatar
	Image_cover @ \Header background
	Image_back @ \Page background
	Theme_option* $mol_button_minor
		click? <=> theme_select*? null
		sub /
			<= Theme_swatch* $mol_view
				style <= theme_swatch* *
			<= Theme_name* $mol_view
				sub /
					<= theme_name* \

$mol_icon_minus $mol_icon path \M19,13H5V11H19V13Z

$bog_merchquarium_counter $mol_view
	value? 0
	enabled true
	sub <= content /
		<= Minus $mol_button_minor
			hint @ \Less
			click? <=> dec? null
			sub /
				<= Minus_icon $mol_icon_minus
		<= Value $mol_view
			sub /
				<= value_text \
		<= Plus $mol_button_minor
			hint @ \More
			click? <=> inc? null
			sub /
				<= Plus_icon $mol_icon_plus

$bog_merchquarium_cart $mol_list
	catalog_link \
	items? *
	editable true
	Cart_title @ \Cart
	Order_title @ \Order
	Unavailable @ \Sold out
	Total_text @ \Total: {total} ₽
	Order_message @ \Hello! I want to order {count} items for {total} ₽: {link}
	Send_title @ \Send request
	Copy_title @ \Copy order
	Copied_title @ \✓ Copied — open {social}
	Social_missing @ \Order link is not set
	rows /
		<= Back $mol_button_minor
			click? <=> back? null
			sub /
				<= Back_icon $mol_icon_arrow_left
				<= Back_title @ \Back to catalog
		<= Title $mol_paragraph
			title <= heading \
		<= Empty $mol_paragraph
			title @ \Cart is empty
		<= Lines $mol_list
			rows <= lines /
		<= Summary $mol_view
			sub /
				<= Notice $mol_paragraph
					title @ \The information on the site is not a public offer. Availability and price are confirmed by the author when placing the order.
				<= Total $mol_paragraph
					title <= total_text \
		<= Actions $mol_view
			sub /
				<= Send $mol_button_major
					title <= send_title \
					click? <=> send? null
					enabled <= send_enabled true
				<= Clear $mol_button_minor
					title @ \Clear cart
					click? <=> clear? null
		<= Send_hint $mol_paragraph
			title @ \Paste the message into the chat with the author
	Line* $mol_row
		sub /
			<= Thumb* $mol_view
				style <= thumb_style* *
			<= Line_info* $mol_view
				sub /
					<= Line_title* $mol_paragraph
						title <= line_title* \
					<= Line_price* $mol_paragraph
						title <= line_price* \
			<= Counter* $bog_merchquarium_counter
				value? <=> count*? 0
				enabled <= editable
			<= Line_sum* $mol_paragraph
				title <= line_sum* \

$mol_card $mol_list
	attr *
		^
		mol_card_status_type <= status \
	rows /$mol_view
		<= Content $mol_view
			sub <= content /$mol_view_content
				<= title
		<= Status $mol_view
			minimal_height 30
			sub /
				<= status_text <= status \

