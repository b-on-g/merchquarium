$bog_nka_settings $mol_page
	title @ \Settings
	text_id @ \Your Id is: 
	catalog_link? \
	tools /
		<= Sync $giper_baza_status
	body /
		<= Account_id $mol_paragraph
			title <= account_id \
		<= Category_input $mol_string
			hint @ \New category
			value? <=> category_draft? \
		<= Category_add $mol_button_major
			title @ \Add category
			click? <=> category_add? null
		<= Categories_list $mol_list
			rows <= category_rows /
	Category_row* $mol_row
		sub /
			<= Category_title* $mol_paragraph
				title <= category_title* \
			<= Category_remove* $mol_button_minor
				title @ \Remove
				click? <=> category_remove*? null
