$bog_nka_settings $mol_page
	title @ \Settings
	text_id @ \Your Id is: 
	catalog_link? \
	tools /
		<= Sync $giper_baza_status
	body /
		<= Account_id $mol_paragraph
			title <= account_id \
		<= Social_link $mol_string
			hint @ \social link
			value? <=> social_link? \
		<= Social_text $mol_string
			hint @ \Example (used by default message ): "Hello! I want to buy {title}!" 
			value? <=> social_text? \
		<= Category_input $mol_string
			hint @ \New category
			value? <=> category_draft? \
		<= Category_add $mol_button_major
			title @ \Add category
			click? <=> category_add? null
		<= Categories_list $mol_list
			rows <= category_rows /
	Category_row* $mol_row
		sub /
			<= Category_title* $mol_paragraph
				title <= category_title* \
			<= Category_remove* $mol_pop
				Anchor <= Category_remove_button* $mol_button_minor
					title @ \Remove
					click? <=> category_remove*? null
				bubble_content /
					<= Category_confirm_title* $mol_paragraph
						title @ \Delete this category?
					<= Category_confirm_info* $mol_paragraph
						title @ \Deleting it will also clear the category from these products:
					<= Category_confirm_count* $mol_paragraph
						title <= category_product_count* \
					<= Category_confirm_actions* $mol_row
						sub /
							<= Category_cancel* $mol_button_minor
								title @ \Cancel
								click? <=> category_remove_cancel*? null
							<= Category_confirm* $mol_button_major
								title @ \Delete category
								click? <=> category_remove_confirm*? null
